@using WebNet23Online.Localizations.AnimalWorld
@using WebNet23Online.Services.Interfaces
@inject IAuthService authService
<!DOCTYPE html>
<html lang="ru">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - @AnimalWorldReservations.MyTickets</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600&family=Playfair+Display:wght@600;700&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="~/css/tickets/tickets-variables.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/tickets/tickets-base.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/tickets/tickets-layout.css" asp-append-version="true" />
    @await RenderSectionAsync("Styles", required: false)
</head>
<body>
    <header class="tickets-header">
        <div class="tickets-header-container">
            <a href="/" class="tickets-logo">@AnimalWorldReservations.MyTickets</a>
            <nav class="tickets-nav">
                <a href="/" class="tickets-nav-link">
                    <span class="tickets-nav-link-icon">🏠</span>
                    @AnimalWorldCommon.Index
                </a>
                <a href="/AnimalWorld/Index" class="tickets-nav-link">
                    <span class="tickets-nav-link-icon">🦁</span>
                    @AnimalWorldCommon.AnimalWorldTitle
                </a>
                @if (authService.IsAuthenticated())
                {
                    <a href="/Tickets/AllMyTickets" class="tickets-nav-link tickets-nav-link--active">
                        <span class="tickets-nav-link-icon">🎫</span>
                        @AnimalWorldReservations.MyTickets
                    </a>
                }
            </nav>
        </div>
    </header>
    <main class="tickets-main">
        <div class="tickets-container">
            @RenderBody()
        </div>
    </main>
    <footer class="tickets-footer">
        <div class="tickets-footer-container">
            <p>@AnimalWorldCommon.TicketsFooter</p>
        </div>
    </footer>
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>