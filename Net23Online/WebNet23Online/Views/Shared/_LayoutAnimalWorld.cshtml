@using WebNet23Online.Localizations.AnimalWorld
@using WebNet23Online.Services.Interfaces
@inject IAuthService authService
<!DOCTYPE html>
<html lang="ru">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - @AnimalWorldCommon.AmazingAnimalWorld</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600&family=Playfair+Display:wght@600;700&display=swap" rel="stylesheet">
    
    <!-- Базовые стили (нужны на всех страницах) -->
    <link rel="stylesheet" href="~/css/animal-world/variables.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/animal-world/base.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/animal-world/layout.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/animal-world/components.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/animal-world/pages/notifications.css" asp-append-version="true" />
    @await RenderSectionAsync("Styles", required: false)
</head>
<body>
    <header class="site-header">
        <div class="header-container">
            <a href="/" class="logo">@AnimalWorldCommon.AmazingAnimalWorld</a>
            <nav class="main-nav">
                <a href="/" class="nav-link">@AnimalWorldCommon.Index</a>
                <div class="nav-dropdown">
                    <button class="nav-link nav-dropdown-toggle">
                        @AnimalWorldCommon.AnimalWorldTitle <span class="arrow">▾</span>
                    </button>
                    <div class="nav-dropdown-menu">
                        <a href="/AnimalWorld/Index" class="dropdown-link">@AnimalWorldCommon.AnimalWorldTitle</a>
                        <a href="/AnimalWorld/AnimalSpeciesInfo" class="dropdown-link">@AnimalWorldAnimalSpecies.AnimalSpecies</a>
                        <a href="/AnimalWorld/Gallery" class="dropdown-link">@AnimalWorldFacts.Gallery</a>
                        <a href="/AnimalWorld/InterestingFacts" class="dropdown-link">@AnimalWorldFacts.InterestingFacts</a>
                    </div>
                </div>
                @if (authService.IsAuthenticated())
                {
                    <a href="/AnimalWorld/Zoos" class="nav-link">@AnimalWorldZoo.Zoos</a>
                }
                <a href="/AnimalWorld/Promotions" class="nav-link">@AnimalWorldPromotions.Promotions</a>
                @if (authService.AtLeastModerator())
                {
                    <a href="/AnimalWorld/Add" class="nav-link nav-link--accent">@AnimalWorldAddData.AddingData</a>
                }
            </nav>
            <div class="header-actions">
                @if (authService.IsAuthenticated())
                {
                    <a href="/Tickets/AllMyTickets" class="btn btn--secondary">@AnimalWorldReservations.MyTickets</a>
                }
            </div>
        </div>
    </header>
    <main class="site-main">
        <div class="main-container">
            @RenderBody()
        </div>
    </main>
    <footer class="site-footer">
        <div class="footer-container">
            <p>@AnimalWorldCommon.Footer</p>
        </div>
    </footer>
    <div class="notifications-container"></div>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/microsoft-signalr/6.0.1/signalr.js"></script>
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    <script src="~/js/animal-world/new-animal-species-appeared.js"></script>
    <script src="~/js/animal-world/promotions.js"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>