@using WebNet23Online.Localizations
@{
    Layout = "_LayoutAnimalWorld";
    ViewData["Title"] = AnimalWorld.NoBooked;
}

@section Styles {
    <link rel="stylesheet" href="~/css/animal-world/pages/booking-denied.css" asp-append-version="true" />
}

<section class="page-header">
    <h1 class="page-title">@AnimalWorld.NoBooked</h1>
    <div class="title-accent"></div>
</section>

<div class="booking-denied-card">
    <div class="denied-icon">✗</div>
    <h2 class="denied-title">Бронирование не удалось</h2>
    <p class="denied-message">@AnimalWorld.VisitBookedDenyMessage</p>
    <a href="/AnimalWorld/Zoos" class="denied-action">
        <span class="denied-action-icon">←</span>
        @AnimalWorld.BackToZoos
    </a>
</div>