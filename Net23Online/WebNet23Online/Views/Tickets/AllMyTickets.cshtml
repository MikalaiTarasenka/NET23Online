@using WebNet23Online.Localizations
@using WebNet23Online.Models.Tickets
@model AllTicketsViewModel
@{
    Layout = "_LayoutTickets";
    ViewData["Title"] = "Мои билеты";
}
@section Styles {
    <link rel="stylesheet" href="~/css/tickets/animal-tickets.css" asp-append-version="true" />
}
@section Scripts {
    <script src="~/js/tickets/qrcode.js"></script>
    <script src="~/js/tickets/all-my-tickets.js"></script>
}
<section class="page-header">
    <h1 class="page-title">Мои билеты</h1>
    <div class="title-accent"></div>
    <p class="page-subtitle">Здесь собраны билеты из разных разделов сайта</p>
</section>
<section class="tickets-zoo-section" aria-labelledby="zoo-tickets-heading">
    <div class="tickets-zoo-section-header">
        <h2 id="zoo-tickets-heading" class="tickets-zoo-section-title">Зоопарки — Мир животных</h2>
        <div class="section-accent"></div>
    </div>
    @if (Model.CanShowZooTickets)
    {
        <p class="tickets-zoo-hint">Предъявите QR-код на входе в зоопарк</p>
        <div class="tickets-zoo-list">
            @foreach (var ticket in Model.ZooTickets)
            {
                <article class="tickets-zoo-card @(ticket.IsUsed ? "tickets-zoo-card-used" : "")">
                    <div class="tickets-zoo-card-inner">
                        <div class="tickets-zoo-card-body">
                            <h3 class="tickets-zoo-name">@ticket.ZooName</h3>
                            <p class="tickets-zoo-meta">
                                <strong>Дата визита: до</strong> @ticket.EventDate.ToString("dd.MM.yyyy")
                            </p>
                            @if (ticket.IsUsed)
                            {
                                <span class="tickets-zoo-status tickets-zoo-status-used">Использован</span>
                            }
                            else
                            {
                                <span class="tickets-zoo-status tickets-zoo-status-active">Активен</span>
                            }
                        </div>
                        <div class="tickets-zoo-qrcode-panel">
                            <p class="tickets-zoo-qrcode-caption">QR-код</p>
                            <div class="ticket-qrcode" data-qr-value="@ticket.UniqueKey"></div>
                        </div>
                    </div>
                </article>
            }
        </div>
    }
    else
    {
        <div class="empty-container">
            <div class="empty-icon">🎫</div>
            <p class="empty-text">Нет билетов в зоопарки</p>
            <a class="btn btn--primary" href="/AnimalWorld/Zoos">@AnimalWorld.BookNow</a>
        </div>
    }
</section>