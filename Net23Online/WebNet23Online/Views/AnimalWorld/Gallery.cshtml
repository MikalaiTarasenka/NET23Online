@using WebNet23Online.Localizations.AnimalWorld
@model WebNet23Online.Models.AnimalWorld.GalleryViewModel
@{
    Layout = "_LayoutAnimalWorld";
    ViewData["Title"] = AnimalWorldFacts.Gallery;
}
@section Styles {
    <link rel="stylesheet" href="~/css/animal-world/pages/gallery.css" asp-append-version="true" />
}
<section class="page-header">
    <h1 class="page-title">@AnimalWorldFacts.AnimalsGallery</h1>
    <div class="title-accent"></div>
    <p class="page-subtitle">@AnimalWorldFacts.AnimalFacts</p>
</section>
@if (Model.RandomAnimals.Any())
{
    <div class="gallery-grid">
        @foreach (var randomAnimal in Model.RandomAnimals)
        {
            <article class="animal-card">
                <div class="animal-image-wrapper">
                    <img src="@randomAnimal.Image" alt=@AnimalWorldCommon.Animal class="animal-image" />
                </div>
                <div class="animal-fact-wrapper">
                    <div class="animal-fact-label">@AnimalWorldFacts.Fact</div>
                    <p class="animal-fact-text">@randomAnimal.Fact</p>
                </div>
            </article>
        }
    </div>
}
else
{
    <div class="empty-container">
        <div class="empty-icon">🖼️</div>
        <h3 class="empty-title">@AnimalWorldFacts.GalleryEmpty</h3>
        <p class="empty-text">@AnimalWorldFacts.Sorry</p>
    </div>
}