@using WebNet23Online.Localizations.AnimalWorld
@{
    Layout = "_LayoutAnimalWorld";
    ViewData["Title"] = AnimalWorldAddData.AddingData;
}
@section Styles {
    <link rel="stylesheet" href="~/css/animal-world/pages/add-data.css" asp-append-version="true" />
}
<section class="page-header">
    <h1 class="page-title">@AnimalWorldAddData.AddingAnimalData</h1>
    <div class="title-accent"></div>
    <p class="page-subtitle">@AnimalWorldAddData.SelectInformationType:</p>
</section>
<section class="options-group">
    <div class="group-header group-header--animals">
        <span class="group-icon">🐾</span>
        <h2 class="group-title">@AnimalWorldCommon.Animals</h2>
        <p class="group-description">@AnimalWorldAddData.BiologicalData</p>
    </div>
    <div class="add-options-grid">
        <a href="/AnimalWorld/AddFamily" class="option-card option-card--animals">
            <div class="option-icon">🌿</div>
            <h3 class="option-title">@AnimalWorldAnimalFamily.AddAnimalFamily</h3>
            <p class="option-description">@AnimalWorldAddData.AddingGenus</p>
            <span class="option-arrow">→</span>
        </a>
        <a href="/AnimalWorld/AddSpecies" class="option-card option-card--animals">
            <div class="option-icon">🦁</div>
            <h3 class="option-title">@AnimalWorldAnimalSpecies.AddAnimalSpecies</h3>
            <p class="option-description">@AnimalWorldAddData.AddingSpecies</p>
            <span class="option-arrow">→</span>
        </a>
        <a href="/AnimalWorld/BindZooAndAnimalSpecies" class="option-card option-card--animals">
            <div class="option-icon">🔗</div>
            <h3 class="option-title">@AnimalWorldZoo.AnimalSpeciesZoosLinks</h3>
            <p class="option-description">@AnimalWorldAddData.Associate</p>
            <span class="option-arrow">→</span>
        </a>
    </div>
</section>
<section class="options-group">
    <div class="group-header group-header--infrastructure">
        <span class="group-icon">🏛️</span>
        <h2 class="group-title">@AnimalWorldAddData.Infrastructure</h2>
        <p class="group-description">@AnimalWorldZoo.ZoosTitle</p>
    </div>
    <div class="add-options-grid">
        <a href="/AnimalWorld/AddZoo" class="option-card option-card--infrastructure">
            <div class="option-icon">🐘</div>
            <h3 class="option-title">@AnimalWorldZoo.AddZoo</h3>
            <p class="option-description">@AnimalWorldAddData.AddZoo</p>
            <span class="option-arrow">→</span>
        </a>
    </div>
</section>
<section class="options-group">
    <div class="group-header group-header--marketing">
        <span class="group-icon">🎟️</span>
        <h2 class="group-title">@AnimalWorldAddData.Marketing</h2>
        <p class="group-description">@AnimalWorldPromotions.SpecialOffers</p>
    </div>
    <div class="add-options-grid">
        <a href="/AnimalWorld/AddPromotion" class="option-card option-card--marketing">
            <div class="option-icon">✨</div>
            <h3 class="option-title">@AnimalWorldAddData.AddPromotion</h3>
            <p class="option-description">@AnimalWorldPromotions.PromotionTitle</p>
            <span class="option-arrow">→</span>
        </a>
    </div>
</section>