@using WebNet23Online.Localizations.AnimalWorld
@model WebNet23Online.Models.AnimalWorld.ZooViewModel
@{
    Layout = "_LayoutAnimalWorld";
    ViewData["Title"] = @AnimalWorldZoo.AddZoo;
}
@section Scripts {
    <script src="~/js/animal-world/add-zoo.js"></script>
}
<section class="page-header">
    <h1 class="page-title">@AnimalWorldZoo.AddZoo</h1>
    <div class="title-accent"></div>
    <p class="page-subtitle">@AnimalWorldZoo.ZooInfo</p>
</section>
<form method="post" class="form-container js-add-zoo-form">
    <div class="form-card">
        <div class="form-field">
            <label for="ZooName" class="form-label">
                @AnimalWorldZoo.ZooName <span class="required">*</span>
            </label>
            @Html.TextBoxFor(zoo => zoo.ZooName, new
            {
                @class = "form-control",
                id = "ZooName",
                type = "text",
                placeholder = @AnimalWorldZoo.ZooExample,
                autocomplete = "off"
            })
            <div id="zoo-name-feedback" class="zoo-name-feedback" aria-live="polite" 
                 data-msg-checking="@AnimalWorldZoo.ZooNameChecking"
                 data-msg-available="@AnimalWorldZoo.ZooNameAvailable"
                 data-msg-taken="@AnimalWorldZoo.ZooNameTaken"
                 data-msg-error="@AnimalWorldZoo.Error"></div>
            @Html.ValidationMessageFor(zoo => zoo.ZooName, "", new { @class = "validation-error" })
        </div>
        <div class="form-field">
            <label for="Address" class="form-label">
                @AnimalWorldZoo.Address <span class="required">*</span>
            </label>
            @Html.TextBoxFor(zoo => zoo.Address, new
            {
                @class = "form-control",
                id = "Address",
                type = "text",
                placeholder = @AnimalWorldZoo.AddressExample
            })
            @Html.ValidationMessageFor(zoo => zoo.Address, "", new { @class = "validation-error" })
        </div>
        <div class="form-field">
            <label for="Description" class="form-label">
                @AnimalWorldCommon.Description <span class="required">*</span>
            </label>
            @Html.TextAreaFor(zoo => zoo.Description, new
            {
                @class = "form-control form-textarea",
                id = "Description",
                placeholder = @AnimalWorldZoo.ZooSummary,
                rows = 6
            })
            @Html.ValidationMessageFor(zoo => zoo.Description, "", new { @class = "validation-error" })
        </div>
        <div class="form-actions">
            <button type="submit" class="btn btn--primary">
                <span class="btn-icon">✓</span>
                @AnimalWorldCommon.Add
            </button>
        </div>
    </div>
</form>