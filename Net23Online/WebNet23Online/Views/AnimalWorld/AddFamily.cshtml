@using WebNet23Online.Localizations.AnimalWorld
@model WebNet23Online.Models.AnimalWorld.AnimalFamilyViewModel
@{
    Layout = "_LayoutAnimalWorld";
    ViewData["Title"] = @AnimalWorldAnimalFamily.AddAnimalFamily;
}

<section class="page-header">
    <h1 class="page-title">@AnimalWorldAnimalFamily.AddAnimalFamily</h1>
    <div class="title-accent"></div>
    <p class="page-subtitle">@AnimalWorldAnimalFamily.FillInformation</p>
</section>
<form method="post" class="form-container">
    <div class="form-card">
        <div class="form-field">
            <label for="AnimalFamilyName" class="form-label">
                @AnimalWorldAnimalFamily.FamilyName <span class="required">*</span>
            </label>
            @Html.TextBoxFor(family => family.AnimalFamilyName, new
            {
                @class = "form-control",
                id = "AnimalFamilyName",
                type = "text",
                placeholder = AnimalWorldAnimalFamily.AnimalFamilyExample
            })
            @Html.ValidationMessageFor(family => family.AnimalFamilyName, "", new { @class = "validation-error" })
        </div>
        <div class="form-field">
            <label for="Description" class="form-label">
                @AnimalWorldCommon.Description <span class="required">*</span>
            </label>
            @Html.TextAreaFor(family => family.Description, new
            {
                @class = "form-control form-textarea",
                id = "Description",
                placeholder = @AnimalWorldAnimalFamily.AnimalFamilySummary,
                rows = 8
            })
            @Html.ValidationMessageFor(family => family.Description, "", new { @class = "validation-error" })
        </div>
        <div class="form-actions">
            <button type="submit" class="btn btn--primary">
                <span class="btn-icon">✓</span>
                @AnimalWorldCommon.Add
            </button>
        </div>
    </div>
</form>