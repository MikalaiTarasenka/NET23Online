@using WebNet23Online.Localizations
@model WebNet23Online.Models.AnimalWorld.AnimalFamilyViewModel
@{
    Layout = "_LayoutAnimalWorld";
    ViewData["Title"] = AnimalWorld.AddAnimalFamily;
}

<section class="page-header">
    <h1 class="page-title">@AnimalWorld.AddAnimalFamily</h1>
    <div class="title-accent"></div>
    <p class="page-subtitle">Заполните информацию о новом семействе животных</p>
</section>

<form method="post" class="family-form">
    <div class="form-card">
        <div class="form-field">
            <label for="AnimalFamilyName" class="form-label">
                @AnimalWorld.FamilyName <span class="required">*</span>
            </label>
            @Html.TextBoxFor(family => family.AnimalFamilyName, new
            {
                @class = "form-control",
                id = "AnimalFamilyName",
                type = "text",
                placeholder = AnimalWorld.AnimalFamilyExample
            })
            @Html.ValidationMessageFor(family => family.AnimalFamilyName, "", new { @class = "validation-error" })
        </div>

        <div class="form-field">
            <label for="Description" class="form-label">
                @AnimalWorld.Description <span class="required">*</span>
            </label>
            @Html.TextAreaFor(family => family.Description, new
            {
                @class = "form-control form-textarea",
                id = "Description",
                placeholder = AnimalWorld.AnimalFamilySummary,
                rows = 8
            })
            @Html.ValidationMessageFor(family => family.Description, "", new { @class = "validation-error" })
        </div>

        <div class="form-actions">
            <button type="submit" class="btn btn--primary">
                <span class="btn-icon">✓</span>
                @AnimalWorld.Add
            </button>
        </div>
    </div>
</form>