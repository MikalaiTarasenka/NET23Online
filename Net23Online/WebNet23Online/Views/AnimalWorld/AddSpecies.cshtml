@using WebNet23Online.Localizations.AnimalWorld
@model WebNet23Online.Models.AnimalWorld.AnimalSpeciesViewModel
@{
    Layout = "_LayoutAnimalWorld";
    ViewData["Title"] = @AnimalWorldAnimalSpecies.AddAnimalSpecies;
}
@section Styles {
    <link rel="stylesheet" href="~/css/animal-world/pages/add-species.css" asp-append-version="true" />
}
@section Scripts {
    <script src="~/js/animal-world/add-species.js"></script>
}
<section class="page-header">
    <h1 class="page-title">@AnimalWorldAnimalSpecies.AddAnimalSpecies</h1>
    <div class="title-accent"></div>
</section>
<form method="post" enctype="multipart/form-data" class="form-container">
    <div class="form-layout">
        <div class="form-fields">
            <div class="form-field">
                <label for="AnimalSpeciesName" class="form-label">
                    @AnimalWorldAnimalSpecies.SpeciesName <span class="required">*</span>
                </label>
                @Html.TextBoxFor(species => species.AnimalSpeciesName, new
                {
                    @class = "form-control",
                    id = "AnimalSpeciesName",
                    type = "text",
                    placeholder = @AnimalWorldAnimalSpecies.AnimalSpeciesExample
                })
                @Html.ValidationMessageFor(species => species.AnimalSpeciesName, "", new { @class = "validation-error" })
            </div>
            <div class="form-field">
                <label class="form-label">
                    @AnimalWorldAnimalSpecies.UploadImage
                </label>
                <div class="file-upload-wrapper">
                    <input id="image-input" type="file" name="AnimalSpeciesImage" class="file-input-hidden" accept="image/*" />
                    <label for="image-input" class="file-upload-button">
                        <span class="file-upload-icon">📷</span>
                        <span class="file-upload-text">@AnimalWorldAnimalSpecies.SelectImage</span>
                    </label>
                    <span class="file-upload-hint">JPG, PNG @AnimalWorldAnimalSpecies.Till 5MB</span>
                </div>
            </div>
            <div class="form-field">
                <label for="AnimalFamilyId" class="form-label">
                    @AnimalWorldAnimalFamily.AnimalFamily <span class="required">*</span>
                </label>
                @Html.DropDownListFor(species => species.AnimalFamilyId, Model.AnimalFamilyNames, @AnimalWorldAnimalFamily.ChooseAnimalFamily, new
                {
                    @class = "form-control",
                    id = "AnimalFamilyId"
                })
                @Html.ValidationMessageFor(species => species.AnimalFamilyId, "", new { @class = "validation-error" })
            </div>
            <div class="form-field">
                <label for="NativeRange" class="form-label">
                    @AnimalWorldAnimalSpecies.Habitat <span class="required">*</span>
                </label>
                @Html.TextBoxFor(species => species.NativeRange, new
                {
                    @class = "form-control",
                    id = "NativeRange",
                    type = "text",
                    placeholder = @AnimalWorldAnimalSpecies.HabitatExample
                })
                @Html.ValidationMessageFor(species => species.NativeRange, "", new { @class = "validation-error" })
            </div>
            <div class="form-field">
                <label for="Description" class="form-label">
                    @AnimalWorldCommon.Description <span class="required">*</span>
                </label>
                @Html.TextAreaFor(species => species.Description, new
                {
                    @class = "form-control form-textarea",
                    id = "Description",
                    placeholder = @AnimalWorldAnimalSpecies.AnimalSpeciesSummary + "...",
                    rows = 6
                })
                @Html.ValidationMessageFor(species => species.Description, "", new { @class = "validation-error" })
            </div>
            <div class="form-actions">
                <button type="submit" class="btn btn--primary">
                    <span class="btn-icon">✓</span>
                    @AnimalWorldCommon.Add
                </button>
            </div>
        </div>
        <div class="form-preview">
            <div class="preview-card">
                <h3 class="preview-title">@AnimalWorldAnimalSpecies.Preview</h3>
                <div id="preview-container" class="preview-image-wrapper">
                    <img id="image-preview" src="#" alt=@AnimalWorldAnimalSpecies.Preview class="preview-image" style="display: none;" />
                    <div class="preview-placeholder">
                        <span class="placeholder-icon">🖼️</span>
                        <p class="placeholder-text">@AnimalWorldAnimalSpecies.UploadImageHint</p>
                    </div>
                </div>
                <div class="preview-info">
                    <p class="preview-hint">💡 @AnimalWorldAnimalSpecies.CardLook</p>
                </div>
            </div>
        </div>
    </div>
</form>