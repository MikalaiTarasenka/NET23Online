@using WebNet23Online.Localizations.AnimalWorld
@using WebNet23Online.Models.AnimalWorld
@model List<PromotionViewModel>
@{
    Layout = "_LayoutAnimalWorld";
    ViewData["Title"] = AnimalWorldPromotions.Promotions;
}
@section Styles {
    <link rel="stylesheet" href="~/css/animal-world/pages/promotions.css" asp-append-version="true" />
}
<section class="page-header">
    <h1 class="page-title">@AnimalWorldPromotions.Promotions</h1>
    <div class="title-accent"></div>
    <p class="page-subtitle">@AnimalWorldPromotions.SpecialOffers</p>
</section>
@if (Model.Any())
{
    <div class="promotions-grid">
        @foreach (var promotion in Model)
        {
            <article class="promotion-card">
                <div class="promotion-header">
                    <div class="promotion-icon">🎟️</div>
                </div>
                <h3 class="promotion-title">@promotion.PromotionName</h3>
                <p class="promotion-description">@promotion.Description</p>
                <div class="promotion-footer">
                    <div class="promotion-meta">
                        <span class="meta-icon">📍</span>
                        <span>@AnimalWorldPromotions.Venue: @promotion.Place</span>
                    </div>
                    <div class="promotion-meta">
                        <span class="meta-icon">📅</span>
                        <span>@AnimalWorldPromotions.Valid: @promotion.EndDate.ToString("dd.MM.yyyy")</span>
                    </div>
                </div>
            </article>
        }
    </div>
}
else
{
    <div class="empty-container">
        <div class="empty-icon">🎫</div>
        <h3 class="empty-title">@AnimalWorldPromotions.NoPromotions</h3>
        <p class="empty-text">@AnimalWorldPromotions.StayTuned</p>
    </div>
}