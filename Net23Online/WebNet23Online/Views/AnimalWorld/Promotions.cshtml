@using WebNet23Online.Models.AnimalWorld
@model List<PromotionViewModel>
@{
    Layout = "_LayoutAnimalWorld";
    ViewData["Title"] = "Акции";
}

<section class="page-header">
    <h1 class="page-title">Акции</h1>
    <div class="title-accent"></div>
    <p class="page-subtitle">Специальные предложения для посетителей наших зоопарков</p>
</section>

@if (Model.Any())
{
    <div class="promotions-grid">
        @foreach (var promotion in Model)
        {
            <article class="promotion-card">
                <div class="promotion-header">
                    <div class="promotion-icon">🎟️</div>
                </div>

                <h3 class="promotion-title">@promotion.PromotionName</h3>
                <p class="promotion-description">@promotion.Description</p>

                <div class="promotion-footer">
                    <div class="promotion-meta">
                        <span class="meta-icon">📍</span>
                        <span>Место проведения: @promotion.Place</span>
                    </div>
                    <div class="promotion-meta">
                        <span class="meta-icon">📅</span>
                        <span>Действительна до: @promotion.EndDate.ToString("dd.MM.yyyy")</span>
                    </div>
                </div>
            </article>
        }
    </div>
}
else
{
    <div class="empty-promotions">
        <div class="empty-icon">🎫</div>
        <h3 class="empty-title">В настоящий момент акции не проводятся</h3>
        <p class="empty-text">Следите за обновлениями — скоро появятся новые интересные предложения!</p>
    </div>
}