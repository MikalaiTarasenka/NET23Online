@using WebNet23Online.Localizations.AnimalWorld
@{
    Layout = "_LayoutAnimalWorld";
    ViewData["Title"] = AnimalWorldFacts.InterestingFacts;
}
@section Styles {
    <link rel="stylesheet" href="~/css/animal-world/pages/interesting-facts.css" asp-append-version="true" />
}
@section Scripts {
    <script src="~/js/animal-world/animal-species-facts.js"></script>
}
<section class="page-header">
    <h1 class="page-title">@AnimalWorldFacts.AnimalFacts</h1>
    <div class="title-accent"></div>
    <p class="page-subtitle">@AnimalWorldFacts.LearnFacts</p>
</section>
<div class="fact-form-card">
    <form class="fact-form" id="fact-form">
        <div class="form-field">
            <label for="animal-type-select" class="form-label">@AnimalWorldAnimalSpecies.One</label>
            <select id="animal-type-select" class="form-control">
                <option>@AnimalWorldCommon.Loading...</option>
            </select>
        </div>
        <div class="form-field">
            <label for="factText" class="form-label">@AnimalWorldFacts.TextFact</label>
            <textarea id="factText" class="form-control form-textarea" rows="4" placeholder=@AnimalWorldFacts.EnterFact></textarea>
        </div>
        <div class="fact-form-actions">
            <button type="button" id="addFactBtn" class="btn btn--primary">
                <span class="btn-icon">💡</span>
                @AnimalWorldCommon.Add
            </button>
            <span id="fact-form-feedback" class="fact-feedback"></span>
        </div>
    </form>
</div>
<section class="facts-section">
    <div class="section-header">
        <h2 class="section-title">@AnimalWorldFacts.KnownFacts</h2>
        <div class="title-accent"></div>
    </div>
    <div id="facts-container" class="facts-list">
        <div class="facts-loading" id="facts-loading-status">@AnimalWorldFacts.LoadingFacts...</div>
    </div>
</section>