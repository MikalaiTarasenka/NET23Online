@using WebNet23Online.Localizations.AnimalWorld
@model WebNet23Online.Models.AnimalWorld.PromotionViewModel
@{
    Layout = "_LayoutAnimalWorld";
    ViewData["Title"] = AnimalWorldPromotions.AddPromotion;
}

<section class="page-header">
    <h1 class="page-title">@AnimalWorldPromotions.AddPromotion</h1>
    <div class="title-accent"></div>
    <p class="page-subtitle">@AnimalWorldPromotions.PromotionTitle</p>
</section>
<form method="post" class="form-container">
    <div class="form-card">
        <div class="form-field">
            <label for="PromotionName" class="form-label">
                @AnimalWorldPromotions.PromotionName <span class="required">*</span>
            </label>
            @Html.TextBoxFor(promotion => promotion.PromotionName, new
            {
                @class = "form-control",
                id = "PromotionName",
                type = "text",
                placeholder = AnimalWorldPromotions.PromotionExample
            })
            @Html.ValidationMessageFor(promotion => promotion.PromotionName, "", new { @class = "validation-error" })
        </div>
        <div class="form-field">
            <label for="Description" class="form-label">
                @AnimalWorldCommon.Description <span class="required">*</span>
            </label>
            @Html.TextAreaFor(promotion => promotion.Description, new
            {
                @class = "form-control form-textarea",
                id = "Description",
                placeholder = AnimalWorldPromotions.Details,
                rows = 5
            })
            @Html.ValidationMessageFor(promotion => promotion.Description, "", new { @class = "validation-error" })
        </div>
        <div class="form-field">
            <label for="ZooId" class="form-label">
                @AnimalWorldPromotions.Venue <span class="required">*</span>
            </label>
            @Html.DropDownListFor(promotion => promotion.ZooId, Model.Zoos, AnimalWorldPromotions.SelectVenue, new
            {
                @class = "form-control",
                id = "ZooId"
            })
            @Html.ValidationMessageFor(promotion => promotion.ZooId, "", new { @class = "validation-error" })
        </div>
        <div class="form-field">
            <label for="EndDate" class="form-label">
                @AnimalWorldPromotions.Valid <span class="required">*</span>
            </label>
            @Html.TextBoxFor(promotion => promotion.EndDate, "{0:yyyy-MM-dd}", new
            {
                @class = "form-control",
                id = "EndDate",
                type = "date",
                min = DateTime.Now.ToString("yyyy-MM-dd")
            })
            @Html.ValidationMessageFor(promotion => promotion.EndDate, "", new { @class = "validation-error" })
        </div>
        <div class="form-actions">
            <button type="submit" class="btn btn--primary">
                <span class="btn-icon">🎟️</span>
                @AnimalWorldCommon.Add
            </button>
        </div>
    </div>
</form>