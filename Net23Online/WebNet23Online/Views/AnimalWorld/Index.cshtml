@using WebNet23Online.Localizations
@model WebNet23Online.Models.AnimalWorld.StartPageAnimalWorldInfoViewModel
@{
    Layout = "_LayoutAnimalWorld";
    ViewData["Title"] = AnimalWorld.AnimalWorldTitle;
}
@section Styles {
    <link rel="stylesheet" href="~/css/animal-world/pages/index.css" asp-append-version="true" />
}
@section Scripts {
    <script src="~/js/animal-world/index.js"></script>
}
<section class="hero-section">
    <div class="hero-content">
        <h1 class="hero-title">@AnimalWorld.AboutPlanet</h1>
        <p class="hero-text">@AnimalWorld.IndexDescription</p>
    </div>
    <div class="hero-image-wrapper">
        <img src="~/images/animal-world/animals.jpg" alt="Мир животных" class="hero-image" />
    </div>
</section>
<section class="content-section">
    <div class="section-header">
        <h2 class="section-title">@AnimalWorld.AnimalFamilies</h2>
        <div class="title-accent"></div>
    </div>
    @if (Model.AnimalFamilies.Any())
    {
        <div class="selection-actions" style="display: none;">
            <button id="delete-selected-btn" class="btn btn--danger">
                <span class="btn-icon">🗑️</span>
                @AnimalWorld.DeleteSelected
            </button>
            <span class="selection-hint">Кликните по карточкам, чтобы выбрать несколько семейств</span>
        </div>
        <div class="grid grid--families">
            @foreach (var family in Model.AnimalFamilies)
            {
                <article class="card card--family js-family-card">
                    <div class="card-selection-indicator"></div>
                    <h3 class="card-title">@family.AnimalFamilyName</h3>
                    <p class="card-text">@family.Description</p>
                </article>
            }
        </div>
    }
    else
    {
        <p class="empty-state">@AnimalWorld.NoAnimalFamilies</p>
    }
</section>
<section class="content-section">
    <div class="section-header">
        <h2 class="section-title">@AnimalWorld.AnimalSpecies</h2>
        <div class="title-accent"></div>
    </div>
    @if (Model.AnimalSpecies.Any())
    {
        <div class="grid grid--species">
            @foreach (var species in Model.AnimalSpecies)
            {
                <article class="card card--species">
                    <div class="card-image-wrapper">
                        <img src="@species.Url" alt="@species.AnimalSpeciesName" class="card-image" />
                    </div>
                    <div class="card-body">
                        <h3 class="card-title">@species.AnimalSpeciesName</h3>
                        <p class="card-meta"><span class="meta-label">Ареал:</span> @species.NativeRange</p>
                        <p class="card-text">@species.Description</p>
                        @if (species.Zoos.Any())
                        {
                            <div class="tags-container">
                                <span class="meta-label">Где можно увидеть:</span>
                                <div class="tags">
                                    @foreach (var zoo in species.Zoos)
                                    {
                                        <span class="tag">@zoo</span>
                                    }
                                </div>
                            </div>
                        }
                    </div>
                </article>
            }
        </div>
    }
    else
    {
        <p class="empty-state">@AnimalWorld.NoAnimalSpecies</p>
    }
</section>