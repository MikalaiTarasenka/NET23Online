@using WebNet23Online.Localizations
@model WebNet23Online.Models.AnimalWorld.BindZooWithAnimalSpeciesViewModel
@{
    Layout = "_LayoutAnimalWorld";
    ViewData["Title"] = AnimalWorld.AnimalSpeciesZoosLinks;
}

<section class="page-header">
    <h1 class="page-title">@AnimalWorld.AnimalSpeciesZoosLinksSetup</h1>
    <div class="title-accent"></div>
    <p class="page-subtitle">@AnimalWorld.SelectZooThenAnimalSpecies</p>
</section>

<form method="post" class="bind-form">
    <div class="form-card">
        <div class="form-field">
            <label for="ZooId" class="form-label">
                @AnimalWorld.Zoo <span class="required">*</span>
            </label>
            @Html.DropDownListFor(zoo => zoo.ZooId, Model.Zoos, AnimalWorld.ChooseZoo, new
            {
                @class = "form-control",
                id = "ZooId"
            })
            @Html.ValidationMessageFor(zoo => zoo.ZooId, "", new { @class = "validation-error" })
        </div>

        <div class="form-field">
            <label for="AnimalSpeciesId" class="form-label">
                @AnimalWorld.AnimalSpecies <span class="required">*</span>
            </label>
            @Html.DropDownListFor(animalSpecies => animalSpecies.AnimalSpeciesId, Model.AnimalSpecies, AnimalWorld.ChooseAnimalSpecies, new
            {
                @class = "form-control",
                id = "AnimalSpeciesId"
            })
            @Html.ValidationMessageFor(animalSpecies => animalSpecies.AnimalSpeciesId, "", new { @class = "validation-error" })
        </div>

        <div class="form-actions">
            <button type="submit" class="btn btn--primary">
                <span class="btn-icon">🔗</span>
                @AnimalWorld.SaveLink
            </button>
        </div>
    </div>
</form>