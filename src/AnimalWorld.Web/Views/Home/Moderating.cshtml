@{
    ViewData["Title"] = "Панель управления";
}

@section Styles {
    <link rel="stylesheet" href="~/css/home/moderating.css" />
}

<section class="section">
    <h2 class="section-title">Панель управления</h2>

    <!-- Группа: Животные -->
    <div class="moderating-group">
        <h3 class="group-title">Животные</h3>
        <div class="grid-2">
            <div class="card moderating-card">
                <div class="card-content">
                    <h3 class="card-heading">Вид животных</h3>
                    <div class="card-actions">
                        <a href="/AnimalSpecies/Form" class="btn btn-primary">Создать</a>
                        <a href="/AnimalSpecies/List" class="btn btn-secondary">Изменить</a>
                    </div>
                </div>
            </div>
            <div class="card moderating-card">
                <div class="card-content">
                    <h3 class="card-heading">Род животных</h3>
                    <div class="card-actions">
                        <a href="/AnimalFamily/Form" class="btn btn-primary">Создать</a>
                        <a href="/AnimalFamily/List" class="btn btn-secondary">Изменить</a>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Группа: Зоопарк -->
    <div class="moderating-group">
        <h3 class="group-title">Зоопарк</h3>
        <div class="grid-2">
            <div class="card moderating-card">
                <div class="card-content">
                    <h3 class="card-heading">Зоопарк</h3>
                    <div class="card-actions">
                        <a href="/Zoo/Form" class="btn btn-primary">Создать</a>
                        <a href="/Zoo/List" class="btn btn-secondary">Изменить</a>
                    </div>
                </div>
            </div>
            <div class="card moderating-card">
                <div class="card-content">
                    <h3 class="card-heading">Акции</h3>
                    <div class="card-actions">
                        <a href="/Promotion/Form" class="btn btn-primary">Создать</a>
                        <a href="/Promotion/List" class="btn btn-secondary">Изменить</a>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>