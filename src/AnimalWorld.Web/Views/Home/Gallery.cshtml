@model AnimalWorld.Web.Models.Home.AnimalGalleryViewModel
@{
    ViewData["Title"] = "Галерея животных";
}

@section Styles {
    <link rel="stylesheet" href="~/css/home/gallery.css" />
}

<section class="section">
    <h2 class="section-title">Галерея животных</h2>

    @if (Model?.RandomAnimals != null && Model.RandomAnimals.Any())
    {
        <div class="grid-3">
            @foreach (var animal in Model.RandomAnimals)
            {
                <div class="card gallery-card">
                    <div class="card-image">
                        @if (!string.IsNullOrEmpty(animal.Image))
                        {
                            <img src="@animal.Image" alt="Животное" />
                        }
                        else
                        {
                            <div class="card-image-placeholder">Нет изображения</div>
                        }
                    </div>
                    <div class="card-content">
                        <p class="fact-text">
                            @(animal.Fact?.Length > 150 ? animal.Fact.Substring(0, 150) + "..." : animal.Fact)
                        </p>
                    </div>
                </div>
            }
        </div>
    }
    else
    {
        <p class="gallery-empty">Не удалось загрузить данные о животных. Попробуйте обновить страницу.</p>
    }
</section>