@model AnimalWorld.Web.Models.Home.HomePageViewModel
@{
    ViewData["Title"] = "Главная страница";
}

@section Styles {
    <link rel="stylesheet" href="~/css/home/index.css" />
}

<!-- СЕКЦИЯ 1: Приветствие -->
<section class="hero-section">
    <h1>Добро пожаловать в мир животных</h1>
    <p>
        Узнайте больше о разнообразии видов, их среде обитания и о том, в каких зоопарках мира их можно увидеть.
    </p>
    <img src="https://images.unsplash.com/photo-1549366021-9f761d450615?auto=format&fit=crop&w=1000&q=80"
         alt="Животные"
         class="hero-image">
</section>

<!-- СЕКЦИЯ 2: 3 семейства животных -->
<section class="section">
    <h2 class="section-title">Популярные семейства</h2>

    @if (Model?.AnimalFamilies != null && Model.AnimalFamilies.Any())
    {
        <div class="grid-3">
            @foreach (var family in Model.AnimalFamilies)
            {
                <div class="card">
                    <div class="card-content">
                        <div class="card-header">
                            <h3>@family.Name</h3>
                        </div>
                        <p class="description">
                            @(family.Description.Length > 180 ? family.Description.Substring(0, 180) + "..." : family.Description)
                        </p>
                    </div>
                </div>
            }
        </div>
    }
    else
    {
        <p style="text-align: center; color: var(--text-muted);">Информация о семействах временно отсутствует.</p>
    }
</section>

<hr class="section-divider" />

<!-- СЕКЦИЯ 3: 3 вида животных -->
<section class="section">
    <h2 class="section-title">Интересные виды</h2>

    @if (Model?.AnimalSpecies != null && Model.AnimalSpecies.Any())
    {
        <div class="grid-3">
            @foreach (var species in Model.AnimalSpecies)
            {
                <div class="card animal-card">
                    <div class="card-image">
                        <img src="@(string.IsNullOrEmpty(species.Url) ? "/images/animals/default.jpg" : species.Url)"
                             alt="@species.Name">
                    </div>
                    <div class="card-content">
                        <div class="card-header">
                            <h3>@species.Name</h3>
                        </div>

                        <div class="card-meta">
                            <div class="meta-item">
                                <strong>Место обитания:</strong>
                                <span>@species.NativeRange</span>
                            </div>
                            <div class="meta-item">
                                <strong>Описание:</strong>
                                <span>@(species.Description.Length > 120 ? species.Description.Substring(0, 120) + "..." : species.Description)</span>
                            </div>
                            <div class="meta-item">
                                <strong>Зоопарки:</strong>
                                <span>@(species.Zoos != null && species.Zoos.Any() ? string.Join(", ", species.Zoos) : "Информация уточняется")</span>
                            </div>
                        </div>
                    </div>
                </div>
            }
        </div>
    }
    else
    {
        <p style="text-align: center; color: var(--text-muted);">Информация о видах временно отсутствует.</p>
    }
</section>