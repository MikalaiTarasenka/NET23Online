@model List<AnimalWorld.Web.Models.Users.TicketViewModel>
@{
    ViewData["Title"] = "Мои билеты";
}

@section Styles {
    <link rel="stylesheet" href="~/css/ticket/tickets.css" />
}

<section class="section">
    <div class="tickets-header">
        <h2 class="tickets-title">Мои билеты</h2>
    </div>

    @if (Model != null && Model.Any())
    {
        <div class="tickets-grid">
            @foreach (var ticket in Model)
            {
                var isUsed = ticket.IsUsed;
                <div class="ticket-card @(isUsed ? "used" : "")">
                    @if (isUsed)
                    {
                        <div class="ticket-used-label">Использован</div>
                    }

                    <h3 class="ticket-zoo">@ticket.ZooName</h3>

                    <div class="ticket-date">
                        <span class="ticket-label">Дата посещения</span>
                        <p class="ticket-date-value">
                            @ticket.EventDate.ToString("dd MMMM yyyy", new System.Globalization.CultureInfo("ru-RU"))
                        </p>
                    </div>

                    <div class="ticket-qr-section">
                        <div class="ticket-qr-container" data-qr-value="@ticket.UniqueKey"></div>
                        <div class="ticket-key">
                            <span class="ticket-label">Номер билета</span>
                            <p class="ticket-key-value">@ticket.UniqueKey</p>
                        </div>
                    </div>

                    <div class="ticket-status">
                        <span class="ticket-label">Статус</span>
                        <span class="ticket-status-badge @(isUsed ? "used" : "active")">
                            @(isUsed ? "Использован" : "Действителен")
                        </span>
                    </div>
                </div>
            }
        </div>
    }
    else
    {
        <div class="tickets-empty">
            <p>У вас пока нет билетов.</p>
            <a href="/Zoo/Index" class="btn btn-primary">Посмотреть зоопарки</a>
        </div>
    }
</section>

@section Scripts {
    <script src="~/js/qrcode.min.js"></script>
    <script src="~/js/qr-generator.js"></script>
}