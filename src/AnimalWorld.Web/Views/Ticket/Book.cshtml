@{
    ViewData["Title"] = "Бронирование успешно";
}

@section Styles {
    <link rel="stylesheet" href="~/css/common/info-pages.css" />
}

<div class="info-container">
    <div class="info-card">
        <h1 class="info-title info-title-success">Бронирование успешно</h1>
        <p class="info-message">
            Ваш билет успешно забронирован. Вы можете просмотреть его в личном кабинете.
        </p>
        
        <div class="info-actions">
            <a asp-controller="Zoo" asp-action="Index" class="btn btn-primary">Вернуться к списку зоопарков</a>
        </div>
    </div>
</div>