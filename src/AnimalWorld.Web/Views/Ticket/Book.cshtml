@{
    ViewData["Title"] = "Booking Successful";
}

<div style="display: flex; justify-content: center; align-items: center; min-height: 70vh; padding: 20px 0;">
    <div style="width: 100%; max-width: 500px; background: white; border: 1px solid #e0e0e0; border-radius: 8px; padding: 40px; box-shadow: 0 2px 8px rgba(0,0,0,0.06); text-align: center;">

        <!-- Иконка успеха -->
        <div style="font-size: 4rem; margin-bottom: 20px;">✓</div>

        <h2 style="color: #27ae60; margin: 0 0 15px 0; font-size: 1.8rem;">Бронирование успешно!</h2>

        <p style="color: #555; font-size: 1rem; line-height: 1.6; margin: 0 0 30px 0;">
            Ваш билет успешно забронирован. Мы ждём вас в зоопарке!
        </p>

        <a href="/Zoo/Index"
           style="display: inline-block; padding: 12px 30px; background-color: #2980b9; color: white; text-decoration: none; border-radius: 4px; font-weight: 600; transition: background-color 0.2s;"
           onmouseover="this.style.backgroundColor='#2471a3'"
           onmouseout="this.style.backgroundColor='#2980b9'">
            Вернуться к списку зоопарков
        </a>
    </div>
</div>