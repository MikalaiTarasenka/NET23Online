@{
    ViewData["Title"] = "Ошибка бронирования";
}

@section Styles {
    <link rel="stylesheet" href="~/css/common/info-pages.css" />
}

<div class="info-container">
    <div class="info-card">
        <h1 class="info-title info-title-error">Ошибка бронирования</h1>
        <p class="info-message">
            Не удалось забронировать билет. Возможно, акция уже завершена или все места заняты.
        </p>
        
        <div class="info-actions">
            <a asp-controller="User" asp-action="Profile" class="btn btn-secondary">Личный кабинет</a>
            <a asp-controller="Zoo" asp-action="Index" class="btn btn-primary">Список зоопарков</a>
        </div>
    </div>
</div>