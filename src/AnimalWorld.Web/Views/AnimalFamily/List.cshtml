@model List<AnimalWorld.Web.Models.Animals.AnimalFamilyViewModel>
@{
    ViewData["Title"] = "Список родов";
}

@section Styles {
    <link rel="stylesheet" href="~/css/common/admin.css" />
}

<section class="section">
    <div class="admin-header">
        <h2 class="admin-title">Список родов</h2>
    </div>

    <a href="/Home/Moderating" class="admin-back">← Назад к панели управления</a>

    @if (Model != null && Model.Any())
    {
        <div class="admin-list">
            @foreach (var family in Model)
            {
                <div class="admin-list-item">
                    <span class="admin-list-name">@family.Name</span>
                    <div class="admin-list-actions">
                        <a href="/AnimalFamily/Form?id=@family.Id" class="btn btn-secondary">Изменить</a>
                        <form method="post" asp-controller="AnimalFamily" asp-action="Delete" style="display: inline;">
                            <input type="hidden" name="id" value="@family.Id" />
                            <button type="submit" class="btn btn-danger" onclick="return confirm('Вы уверены?')">Удалить</button>
                        </form>
                    </div>
                </div>
            }
        </div>
    }
    else
    {
        <div class="admin-empty">
            <p>Роды животных не найдены.</p>
            <a href="/AnimalFamily/Form" class="btn btn-primary">Создать род</a>
        </div>
    }
</section>