@model AnimalWorld.Web.Models.Animals.AnimalFamilyViewModel
@{
    ViewData["Title"] = Model.Id == 0 ? "Создание рода животных" : "Редактирование рода";
}

@section Styles {
    <!-- Общие стили форм уже подключены в _Layout -->
}

<div class="card">
    <div class="create-form">
        <h2 class="admin-title" style="margin-top: 0;">@(Model.Id == 0 ? "Создание рода животных" : "Редактирование рода")</h2>

        <form method="post" asp-controller="AnimalFamily" asp-action="Form">
            <div asp-validation-summary="ModelOnly" class="validation-summary"></div>

            @if (Model.Id != 0)
            {
                <input type="hidden" asp-for="Id" />
            }

            <div class="form-group">
                <label asp-for="Name">Название</label>
                <input asp-for="Name" placeholder="Название рода" />
                <span asp-validation-for="Name" class="field-validation-error"></span>
            </div>

            <div class="form-group">
                <label asp-for="Description">Описание</label>
                <textarea asp-for="Description" placeholder="Описание" rows="5"></textarea>
                <span asp-validation-for="Description" class="field-validation-error"></span>
            </div>

            <div class="form-actions">
                <button type="submit" class="btn btn-primary">@(Model.Id == 0 ? "Создать" : "Сохранить")</button>
                <a href="/Home/Moderating" class="btn btn-secondary">Отмена</a>
            </div>
        </form>
    </div>
</div>