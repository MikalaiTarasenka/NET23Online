@model AnimalWorld.Web.Models.Animals.AnimalFamilyViewModel

@{
    ViewData["Title"] = Model.Id == 0 ? "Create Family" : "Edit Family";
}

<div>
    <h2>@(Model.Id == 0 ? "Create" : "Edit") Animal Family</h2>
    <form method="post" asp-controller="AnimalFamily" asp-action="Form">
        @if (Model.Id != 0)
        {
            <input type="hidden" asp-for="Id" />
        }
        <div>
            <label>Name:</label><br />
            @Html.TextBoxFor(x => x.Name, new { placeholder = "Family name" })
            @Html.ValidationMessageFor(x => x.Name)
        </div>
        <div>
            <label>Description:</label><br />
            @Html.TextAreaFor(x => x.Description, new { placeholder = "Description", rows = 5 })
            @Html.ValidationMessageFor(x => x.Description)
        </div>
        <div>
            <button type="submit">@(Model.Id == 0 ? "Create" : "Save")</button>
        </div>
    </form>
</div>