@model AnimalWorld.Web.Models.Zoos.PromotionViewModel
@{
    ViewData["Title"] = Model.Id == 0 ? "Создание акции" : "Редактирование акции";
}

@section Styles {
    <!-- Общие стили форм уже подключены в _Layout -->
}

<div class="card">
    <div class="create-form">
        <h2 class="admin-title" style="margin-top: 0;">@(Model.Id == 0 ? "Создание акции" : "Редактирование акции")</h2>

        <form method="post" asp-controller="Promotion" asp-action="Form">
            <div asp-validation-summary="ModelOnly" class="validation-summary"></div>

            @if (Model.Id != 0)
            {
                <input type="hidden" asp-for="Id" />
            }

            <div class="form-row">
                <div class="form-group">
                    <label asp-for="Name">Название</label>
                    <input asp-for="Name" placeholder="Название акции" />
                    <span asp-validation-for="Name" class="field-validation-error"></span>
                </div>
                <div class="form-group">
                    <label asp-for="Place">Аттракцион</label>
                    <input asp-for="Place" placeholder="Аттракцион" />
                    <span asp-validation-for="Place" class="field-validation-error"></span>
                </div>
            </div>

            <div class="form-group">
                <label asp-for="ZooId">Зоопарк</label>
                <select asp-for="ZooId" asp-items="Model.Zoos">
                    <option value="">-- Выберите зоопарк --</option>
                </select>
                <span asp-validation-for="ZooId" class="field-validation-error"></span>
            </div>

            <div class="form-group">
                <label asp-for="EndDate">Дата окончания</label>
                <input asp-for="EndDate" type="date" />
                <span asp-validation-for="EndDate" class="field-validation-error"></span>
            </div>

            <div class="form-group">
                <label asp-for="Description">Описание</label>
                <textarea asp-for="Description" placeholder="Описание акции" rows="5"></textarea>
                <span asp-validation-for="Description" class="field-validation-error"></span>
            </div>

            <div class="form-actions">
                <button type="submit" class="btn btn-primary">@(Model.Id == 0 ? "Создать" : "Сохранить")</button>
                <a href="/Home/Moderating" class="btn btn-secondary">Отмена</a>
            </div>
        </form>
    </div>
</div>