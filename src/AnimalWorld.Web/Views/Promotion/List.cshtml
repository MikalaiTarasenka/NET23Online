@model List<AnimalWorld.Web.Models.Zoos.PromotionViewModel>
@{
    ViewData["Title"] = "Список акций";
}

@section Styles {
    <link rel="stylesheet" href="~/css/common/admin.css" />
}

<section class="section">
    <div class="admin-header">
        <h2 class="admin-title">Список акций</h2>
    </div>

    <a href="/Home/Moderating" class="admin-back">← Назад к панели управления</a>

    @if (Model != null && Model.Any())
    {
        <div class="admin-list">
            @foreach (var promotion in Model)
            {
                <div class="admin-list-item">
                    <span class="admin-list-name">@promotion.Name</span>
                    <div class="admin-list-actions">
                        <a href="/Promotion/Form?id=@promotion.Id" class="btn btn-secondary">Изменить</a>
                        <form method="post" asp-controller="Promotion" asp-action="Delete" style="display: inline;">
                            <input type="hidden" name="id" value="@promotion.Id" />
                            <button type="submit" class="btn btn-danger" onclick="return confirm('Вы уверены?')">Удалить</button>
                        </form>
                    </div>
                </div>
            }
        </div>
    }
    else
    {
        <div class="admin-empty">
            <p>Акции не найдены.</p>
            <a href="/Promotion/Form" class="btn btn-primary">Создать акцию</a>
        </div>
    }
</section>