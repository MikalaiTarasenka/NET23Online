@model AnimalWorld.Web.Models.Zoos.BindingViewModel
@{
    ViewData["Title"] = $"Животные зоопарка {Model?.Zoo?.Name}";
}

@section Styles {
    <link rel="stylesheet" href="~/css/zoo/binding.css" />
}

<section class="section">
    <div class="binding-header">
        <h2 class="binding-title">Животные зоопарка @(Model?.Zoo?.Name)</h2>
    </div>

    <a href="/Zoo/List" class="binding-back">← Назад к списку зоопарков</a>

    @if (Model?.Zoo != null)
    {
        <!-- Информация о зоопарке -->
        <div class="binding-info">
            <h3 class="binding-info-name">@Model.Zoo.Name</h3>
            <p class="binding-info-address">@Model.Zoo.Address</p>
        </div>
    }

    <!-- Форма привязки животных -->
    <form method="post" asp-controller="Zoo" asp-action="Binding">
        <input type="hidden" asp-for="ZooId" />

        <h3 class="binding-section-title">Выберите виды животных</h3>

        <div asp-validation-summary="ModelOnly" class="validation-summary"></div>

        <div class="binding-checkboxes">
            @if (Model?.AnimalSpecies != null && Model.AnimalSpecies.Any())
            {
                @foreach (var item in Model.AnimalSpecies)
                {
                    var isChecked = Model.SelectedAnimalSpeciesIds != null
                                    && Model.SelectedAnimalSpeciesIds.Contains(int.Parse(item.Value));
                    var checkboxId = $"species-{item.Value}";

                    <div class="binding-checkbox-item">
                        <input type="checkbox"
                               id="@checkboxId"
                               name="SelectedAnimalSpeciesIds"
                               value="@item.Value"
                               @(isChecked ? "checked" : "") />
                        <label for="@checkboxId">@item.Text</label>
                    </div>
                }
            }
            else
            {
                <p class="binding-empty">Нет доступных видов животных.</p>
            }
        </div>

        <span asp-validation-for="SelectedAnimalSpeciesIds" class="binding-validation-error"></span>

        <div class="binding-actions">
            <button type="submit" class="btn btn-primary">Сохранить</button>
            <a href="/Zoo/List" class="btn btn-secondary">Отмена</a>
        </div>
    </form>
</section>