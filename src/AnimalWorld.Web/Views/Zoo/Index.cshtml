@model AnimalWorld.Web.Models.Zoos.ZooListViewModel
@{
    ViewData["Title"] = "Зоопарки";
}

@section Styles {
    <link rel="stylesheet" href="~/css/zoo/index.css" />
}

<section class="section">
    <div class="zoo-header">
        <h2 class="zoo-title">Зоопарки</h2>
    </div>

    @if (Model?.Zoos != null && Model.Zoos.Any())
    {
        <div class="zoo-grid">
            @foreach (var zoo in Model.Zoos)
            {
                <div class="zoo-card">
                    <h3 class="zoo-card-name">@zoo.Name</h3>
                    <p class="zoo-card-address">@zoo.Address</p>
                    <p class="zoo-card-description">@(zoo.Description?.Length > 150 ? zoo.Description.Substring(0, 150) + "..." : zoo.Description)</p>

                    <div class="zoo-card-actions">
                        <a href="/Ticket/Book?zooId=@zoo.Id" class="btn btn-primary">Забронировать</a>
                        <a href="/Zoo/Comments?id=@zoo.Id" class="btn btn-secondary">Комментарии</a>
                    </div>
                </div>
            }
        </div>

        <!-- Пагинация (статичная для демонстрации) -->
        <nav class="pagination" aria-label="Навигация по страницам">
            <a href="#" class="pagination-item disabled" aria-label="Предыдущая страница">←</a>
            <a href="#" class="pagination-item active" aria-current="page">1</a>
            <a href="#" class="pagination-item">2</a>
            <a href="#" class="pagination-item">3</a>
            <a href="#" class="pagination-item">...</a>
            <a href="#" class="pagination-item">10</a>
            <a href="#" class="pagination-item" aria-label="Следующая страница">→</a>
        </nav>
    }
    else
    {
        <div class="admin-empty">
            <p>Зоопарки не найдены.</p>
        </div>
    }
</section>