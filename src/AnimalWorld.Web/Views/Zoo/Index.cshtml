@model AnimalWorld.Web.Models.Zoos.ZooListViewModel
@{
    ViewData["Title"] = "Зоопарки";
}

@section Styles {
    <link rel="stylesheet" href="~/css/zoo/index.css" />
}

<section class="section">
    <div class="zoo-header">
        <h2 class="zoo-title">Зоопарки</h2>
    </div>

    @if (Model?.Zoos != null && Model.Zoos.Any())
    {
        <div class="zoo-grid">
            @foreach (var zoo in Model.Zoos)
            {
                <div class="zoo-card">
                    <h3 class="zoo-card-name">@zoo.Name</h3>
                    <p class="zoo-card-address">@zoo.Address</p>

                    @if (zoo.AnimalFamilies != null && zoo.AnimalFamilies.Any())
                    {
                        <p class="zoo-card-families">
                            <span class="zoo-card-families-label">Животные:</span>
                            @string.Join(", ", zoo.AnimalFamilies)
                        </p>
                    }

                    <p class="zoo-card-description">@(zoo.Description?.Length > 150 ? zoo.Description.Substring(0, 150) + "..." : zoo.Description)</p>

                    <div class="zoo-card-actions">
                        <a href="/Ticket/Book?zooId=@zoo.Id" class="btn btn-primary">Забронировать</a>
                        <a href="/Zoo/Comments?id=@zoo.Id" class="btn btn-secondary">Комментарии</a>
                    </div>
                </div>
            }
        </div>

        <!-- Пагинация -->
        @if (Model.TotalPages > 1)
        {
            <nav class="pagination" aria-label="Навигация по страницам">
                @if (Model.HasPreviousPage)
                {
                    <a href="?page=@(Model.CurrentPage - 1)" class="pagination-item" aria-label="Предыдущая страница">←</a>
                }
                else
                {
                    <span class="pagination-item disabled" aria-label="Предыдущая страница">←</span>
                }

                @foreach (var pageNumber in Model.PageNumbers)
                {
                    @if (pageNumber == Model.CurrentPage)
                    {
                        <span class="pagination-item active" aria-current="page">@pageNumber</span>
                    }
                    else
                    {
                        <a href="?page=@pageNumber" class="pagination-item">@pageNumber</a>
                    }
                }

                @if (Model.HasNextPage)
                {
                    <a href="?page=@(Model.CurrentPage + 1)" class="pagination-item" aria-label="Следующая страница">→</a>
                }
                else
                {
                    <span class="pagination-item disabled" aria-label="Следующая страница">→</span>
                }
            </nav>
        }
    }
    else
    {
        <div class="admin-empty">
            <p>Зоопарки не найдены.</p>
        </div>
    }
</section>