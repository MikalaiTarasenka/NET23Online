@model AnimalWorld.Web.Models.Zoos.ZooViewModel

@{
    ViewData["Title"] = Model.Id == 0 ? "Create Zoo" : "Edit Zoo";
}

<div>
    <h2>@(Model.Id == 0 ? "Create" : "Edit") Zoo</h2>
    <form method="post" asp-controller="Zoo" asp-action="Form">
        @if (Model.Id != 0)
        {
            <input type="hidden" asp-for="Id" />
        }
        <div>
            <label>Name:</label><br />
            @Html.TextBoxFor(x => x.Name, new { placeholder = "Zoo name" })
            @Html.ValidationMessageFor(x => x.Name)
        </div>
        <div>
            <label>Address:</label><br />
            @Html.TextBoxFor(x => x.Address, new { placeholder = "Address" })
            @Html.ValidationMessageFor(x => x.Address)
        </div>
        <div>
            <label>Description:</label><br />
            @Html.TextAreaFor(x => x.Description, new { placeholder = "Description", rows = 5 })
            @Html.ValidationMessageFor(x => x.Description)
        </div>
        <div>
            <button type="submit">@(Model.Id == 0 ? "Create" : "Save")</button>
        </div>
    </form>
</div>