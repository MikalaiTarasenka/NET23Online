@using AnimalWorld.Core.Services.Interfaces.Users
@inject IAuthService authService
<!DOCTYPE html>
<html lang="ru">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - AnimalWorld</title>
    <style>
            /* Базовый сброс и шрифты */
            body {
                margin: 0;
                font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
                background-color: #fafafa;
                color: #333;
                display: flex;
                flex-direction: column;
                min-height: 100vh;
            }

            /* Навигация */
            header {
                background-color: #2c3e50;
                color: white;
                padding: 0 20px;
            }

            .nav-container {
                max-width: 1200px;
                margin: 0 auto;
                display: flex;
                justify-content: space-between;
                align-items: center;
                height: 60px;
            }

            .logo {
                font-size: 1.25rem;
                font-weight: bold;
                color: white;
                text-decoration: none;
            }

            .nav-links {
                display: flex;
                gap: 20px;
                align-items: center;
                list-style: none;
                margin: 0;
                padding: 0;
            }

                .nav-links a {
                    color: #ecf0f1;
                    text-decoration: none;
                    font-size: 0.95rem;
                    transition: color 0.2s;
                }

                    .nav-links a:hover {
                        color: #3498db;
                    }

            /* Выпадающее меню на чистом CSS */
            .dropdown {
                position: relative;
            }

            .dropdown-menu {
                display: none;
                position: absolute;
                top: 100%;
                left: 0;
                background-color: white;
                border: 1px solid #ddd;
                border-radius: 4px;
                box-shadow: 0 4px 6px rgba(0,0,0,0.1);
                min-width: 150px;
                z-index: 100;
                padding: 5px 0;
            }

            .dropdown:hover .dropdown-menu {
                display: block;
            }

            .dropdown-menu a {
                display: block;
                padding: 8px 15px;
                color: #333;
            }

                .dropdown-menu a:hover {
                    background-color: #f1f1f1;
                    color: #2c3e50;
                }

            /* Правая часть навигации */
            .auth-section {
                display: flex;
                align-items: center;
                gap: 15px;
                font-size: 0.9rem;
            }

            .btn {
                padding: 6px 14px;
                border-radius: 4px;
                text-decoration: none;
                font-size: 0.9rem;
                font-weight: 500;
            }

            .btn-login {
                color: white;
                border: 1px solid white;
            }

                .btn-login:hover {
                    background-color: white;
                    color: #2c3e50;
                }

            .btn-register {
                background-color: #e67e22;
                color: white;
                border: 1px solid #e67e22;
            }

                .btn-register:hover {
                    background-color: #d35400;
                }

            /* Основной контент и футер */
            main {
                max-width: 1200px;
                margin: 30px auto;
                padding: 0 20px;
                flex: 1;
                width: 100%;
                box-sizing: border-box;
            }

            footer {
                background-color: #2c3e50;
                color: #bdc3c7;
                text-align: center;
                padding: 20px;
                font-size: 0.9rem;
                margin-top: auto;
            }
    </style>
</head>
<body>
    <header>
        <div class="nav-container">
            <a href="/" class="logo">🐾 AnimalWorld</a>

            <ul class="nav-links">
                <li><a href="/">Главная</a></li>
                <li class="dropdown">
                    <a href="#">Каталог ▼</a>
                    <div class="dropdown-menu">
                        <a href="/Families">Семейства</a>
                        <a href="/Species">Виды</a>
                    </div>
                </li>
                <li><a href="/About">О нас</a></li>
            </ul>

            <div class="auth-section">

                @if (authService.IsAuthenticated())
                {
                    <span>Здравствуйте, @authService.GetUserName()</span>
                    <a href="/Auth/Logout" class="btn btn-login">Выход</a>
                }
                else
                {
                    <span>Здравствуйте, Гость</span>
                    <a href="/Auth/Login" class="btn btn-login">Вход</a>
                    <a href="/Auth/Register" class="btn btn-register">Регистрация</a>
                }

            </div>
        </div>
    </header>

    <main>
        @RenderBody()
    </main>

    <footer>
        &copy; @DateTime.Now.Year - AnimalWorld. Индивидуальный проект.
    </footer>
</body>
</html>