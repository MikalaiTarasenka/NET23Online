@using AnimalWorld.Core.Services.Interfaces.Users
@inject IAuthService authService
<!DOCTYPE html>
<html lang="ru">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Мир Животных</title>

    <!-- Общие стили -->
    <link rel="stylesheet" href="~/css/common/variables.css" />
    <link rel="stylesheet" href="~/css/common/base.css" />
    <link rel="stylesheet" href="~/css/common/layout.css" />
    <link rel="stylesheet" href="~/css/common/components.css" />
    <link rel="stylesheet" href="~/css/common/forms.css" />

    <!-- Уникальные стили страниц -->
    @RenderSection("Styles", required: false)
</head>
<body>
    <header class="main-header">
        <nav class="navbar">
            <a href="/" class="nav-brand">Мир Животных</a>

            <ul class="nav-links">
                <li><a href="/">Главная</a></li>
                <li class="dropdown">
                    <a href="#">Животные ▾</a>
                    <ul class="dropdown-menu">
                        <li><a href="/Home/Gallery">Галерея</a></li>
                        <li><a href="/AnimalSpecies/Info">Виды животных</a></li>
                    </ul>
                </li>
                @if (authService.IsAtLeastModerator())
                {
                    <li><a href="/Home/Moderating">Панель управления</a></li>
                }
                <li><a href="/Zoo/Index">Зоопарки</a></li>
            </ul>

            <div class="user-actions">
                @if (authService.IsAuthenticated())
                {
                    <span class="greeting">Здравствуйте, @authService.GetUserName()</span>
                    <div class="dropdown">
                        <a href="/User/Profile" class="btn btn-primary">Личный кабинет ▾</a>
                        <ul class="dropdown-menu">
                            <li><a href="/Ticket/Tickets">Мои билеты</a></li>
                        </ul>
                    </div>
                    <a href="/Auth/Logout" class="btn btn-outline">Выход</a>
                }
                else
                {
                    <span class="greeting">Здравствуйте, Гость</span>
                    <a href="/Auth/Login" class="btn btn-outline">Вход</a>
                    <a href="/Auth/Register" class="btn btn-primary">Регистрация</a>
                }
            </div>
        </nav>
    </header>

    <main>
        <div class="container">
            @RenderBody()
        </div>
    </main>

    <footer class="main-footer">
        &copy; @DateTime.Now.Year - FaunaWorld. Индивидуальный проект.
    </footer>

    <!-- jQuery -->
    <script src="~/js/jquery.min.js"></script>
    
    <!-- Скрипты страниц -->
    @RenderSection("Scripts", required: false)
</body>
</html>