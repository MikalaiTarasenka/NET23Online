@model AnimalWorld.Web.Models.Animals.AnimalSpeciesInfoListViewModel
@{
    ViewData["Title"] = "Виды животных";
}
@section Styles {
    <link rel="stylesheet" href="~/css/animal-species/info.css" />
}
<section class="section">
    <h2 class="section-title">Виды животных</h2>

    <!-- Форма поиска -->
    <form asp-controller="AnimalSpecies" asp-action="Info" method="get" class="search-form">
        <select name="searchCategory" class="search-select">
            <option value="All" selected="@(Model.SearchCategory == "All")">Все поля</option>
            <option value="Species" selected="@(Model.SearchCategory == "Species")">Вид</option>
            <option value="Family" selected="@(Model.SearchCategory == "Family")">Семейство</option>
            <option value="Range" selected="@(Model.SearchCategory == "Range")">Место обитания</option>
        </select>
        <input type="text"
               name="searchQuery"
               value="@Model.SearchQuery"
               placeholder="Поиск по видам, семействам, местам обитания..."
               class="search-input" />
        <button type="submit" class="search-button">Найти</button>
    </form>

    <!-- Таблица видов -->
    @if (Model.Animals != null && Model.Animals.Any())
    {
        <div class="data-table">
            <!-- Заголовки -->
            <div class="data-table-header">
                <div class="data-table-cell">Вид</div>
                <div class="data-table-cell">Семейство</div>
                <div class="data-table-cell">Место обитания</div>
            </div>
            <!-- Строки -->
            @foreach (var species in Model.Animals)
            {
                <div class="data-table-row">
                    <div class="data-table-cell" data-label="Вид">@species.AnimalSpeciesName</div>
                    <div class="data-table-cell" data-label="Семейство">@species.AnimalFamilyName</div>
                    <div class="data-table-cell" data-label="Место обитания">@species.NativeRange</div>
                </div>
            }
        </div>

        <!-- Пагинация -->
        @if (Model.TotalPages > 1)
        {
            <nav class="pagination" aria-label="Навигация по страницам">
                @if (Model.HasPreviousPage)
                {
                    <a href="@Url.Action("Info", "AnimalSpecies", new { page = Model.CurrentPage - 1, searchCategory = Model.SearchCategory, searchQuery = Model.SearchQuery })"
                       class="pagination-item" aria-label="Предыдущая страница">←</a>
                }
                else
                {
                    <span class="pagination-item disabled" aria-label="Предыдущая страница">←</span>
                }

                @foreach (var pageNumber in Model.PageNumbers)
                {
                    @if (pageNumber == Model.CurrentPage)
                    {
                        <span class="pagination-item active" aria-current="page">@pageNumber</span>
                    }
                    else
                    {
                        <a href="@Url.Action("Info", "AnimalSpecies", new { page = pageNumber, searchCategory = Model.SearchCategory, searchQuery = Model.SearchQuery })"
                           class="pagination-item">@pageNumber</a>
                    }
                }

                @if (Model.HasNextPage)
                {
                    <a href="@Url.Action("Info", "AnimalSpecies", new { page = Model.CurrentPage + 1, searchCategory = Model.SearchCategory, searchQuery = Model.SearchQuery })"
                       class="pagination-item" aria-label="Следующая страница">→</a>
                }
                else
                {
                    <span class="pagination-item disabled" aria-label="Следующая страница">→</span>
                }
            </nav>
        }
    }
    else
    {
        <p class="data-table-empty">Виды животных не найдены.</p>
    }
</section>