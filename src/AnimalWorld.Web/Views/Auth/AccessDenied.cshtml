@{
    ViewData["Title"] = "Access Denied";
}

<div style="display: flex; justify-content: center; align-items: center; min-height: 70vh; padding: 20px 0;">
    <div style="text-align: center;">
        <h1 style="color: #c0392b; font-size: 2rem; margin: 0 0 15px 0;">Доступ запрещён</h1>
        <p style="color: #555; font-size: 1rem; margin: 0 0 25px 0;">У вас недостаточно прав для просмотра этой страницы.</p>
        <a href="/"
           style="display: inline-block; padding: 10px 25px; background-color: #2980b9; color: white; text-decoration: none; border-radius: 4px; font-weight: 600; transition: background-color 0.2s;"
           onmouseover="this.style.backgroundColor='#2471a3'"
           onmouseout="this.style.backgroundColor='#2980b9'">
            На главную
        </a>
    </div>
</div>