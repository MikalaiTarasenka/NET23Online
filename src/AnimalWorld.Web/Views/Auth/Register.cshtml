@model AnimalWorld.Web.Models.Users.CredentialsViewModel
@{
    ViewData["Title"] = "Создать аккаунт";
}

@section Styles {
    <link rel="stylesheet" href="~/css/auth/auth.css" />
}

<div class="auth-container">
    <div class="auth-card">
        <h1 class="auth-title">Создать аккаунт</h1>
        <p class="auth-subtitle">Заполните данные для регистрации</p>

        <div asp-validation-summary="ModelOnly" class="validation-summary"></div>

        <form method="post" asp-controller="Auth" asp-action="Register" class="auth-form">
            <div class="form-group">
                <label asp-for="UserName">Имя пользователя</label>
                <input asp-for="UserName" placeholder="Придумайте имя пользователя" />
                <span asp-validation-for="UserName" class="field-validation-error"></span>
            </div>

            <div class="form-group">
                <label asp-for="Password">Пароль</label>
                <input asp-for="Password" placeholder="Придумайте пароль" />
                <span asp-validation-for="Password" class="field-validation-error"></span>
            </div>

            <button type="submit" class="btn btn-primary">Зарегистрироваться</button>
        </form>

        <div class="auth-footer">
            Уже есть аккаунт? <a asp-controller="Auth" asp-action="Login">Войти</a>
        </div>
    </div>
</div>