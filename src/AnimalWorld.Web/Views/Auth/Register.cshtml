@model AnimalWorld.Web.Models.Users.CredentialsViewModel

@{
    ViewData["Title"] = "Register";
}

<div>
    <form method="post" asp-controller="Auth" asp-action="Register">
        <div>
            @Html.TextBoxFor(x => x.UserName, new { placeholder = "UserName" })
            @Html.ValidationMessageFor(x => x.UserName)
        </div>
        <div>
            @Html.PasswordFor(x => x.Password, new { placeholder = "Password" })
            @Html.ValidationMessageFor(x => x.Password)
        </div>
        <div>
            <button type="submit">Register</button>
        </div>
    </form>
</div>